// escritorio — ferramenta de trabalho: barra lateral berinjela com os
// servidores em lista e a conversa no branco. Exclusivo: barra superior com
// voltar/avançar entre abas, busca no servidor e ajuda. Berinjela em degradê,
// fios finos e a caixa de texto flutuando.
theme "escritorio" description="Ferramenta de trabalho: barra superior com busca, servidores em lista." description-en="Work tool: top bar with search, servers in a list." author="SigmaCord" preview=office

options {
    option "topo" label="Barra superior" description="Voltar/avançar entre abas, busca no servidor e ajuda." label-en="Top bar" description-en="Back/forward between tabs, server search and help." default=#true
    option "servidores" label="Lista de servidores" description="Os servidores no topo da barra lateral." label-en="Server list" description-en="The servers at the top of the sidebar." default=#true
    option "abas" label="Abas de canal" description="Mostra os canais abertos em abas acima da conversa." label-en="Channel tabs" description-en="Shows open channels as tabs above the conversation." default=#false
    option "status" label="Barra de status" description="Conexão, ping, RAM e relógio no rodapé." label-en="Status bar" description-en="Connection, ping, RAM and clock at the bottom." default=#false
}

colors mode=light {
    bg          "#ffffff"
    rail        "#3f0e40"
    sidebar     "#3f0e40"
    surface     "#ffffff"
    elevated    "#f8f8f9"
    overlay     "#ffffff"
    text        "#1d1c1d"
    muted       "#616061"
    faint       "#9e9ea6"
    accent      "#1164a3"
    accent-text "#ffffff"
    border      "#e2e2e4"
    hover       "alpha(#1d1c1d, 0.05)"
    selected    "alpha(#1164a3, 0.12)"
    online      "#2bac76"
    danger      "#e01e5a"
    mention     "#1164a3"
    link        "#1264a3"
    code-bg     "#f1f1f3"
    bubble-self "#1164a3"
    bubble-other "#f4f4f6"
    shadow      "alpha(black, 0.12)"
}
roles mode=light "#1164a3" "#e01e5a" "#2bac76" "#b8860b" "#7c3085" "#d9772d" "#1f9fd0" "#4a154b"

colors mode=dark {
    bg          "#1a1d21"
    rail        "#19171d"
    sidebar     "#19171d"
    surface     "#1a1d21"
    elevated    "#222529"
    overlay     "#222529"
    text        "#d1d2d3"
    muted       "#9a9b9e"
    faint       "#6b6c70"
    accent      "#1d9bd1"
    accent-text "#ffffff"
    border      "#2f3236"
    hover       "alpha(white, 0.04)"
    selected    "alpha(#1d9bd1, 0.18)"
    online      "#2bac76"
    danger      "#e01e5a"
    mention     "#1d9bd1"
    link        "#1d9bd1"
    code-bg     "#222529"
    shadow      "alpha(black, 0.45)"
}
roles mode=dark "#36c5f0" "#e8678a" "#2bac76" "#ecb22e" "#c58af9" "#f2994a" "#4fd1c5" "#d1d2d3"

fonts ui="Inter" mono="JetBrains Mono" size=15
metrics radius=6

styles {
    style "berinjela" gradient="lighten(@sidebar, 0.07) @sidebar darken(@sidebar, 0.10)"
    style "topo" gradient="darken(@rail, 0.08) @rail" gradient-angle=0 border-bottom="alpha(#ffffff, 0.10)"
    style "pe" gradient="@rail darken(@rail, 0.14)" border-top="alpha(#ffffff, 0.10)"
    style "lateral" gradient="@elevated darken(@elevated, 0.015)" border-left="@border"
}

layout {
    column {
        topbar height=42 style=topo when=topo c-text="#ffffff" c-muted="#cdbdcd" c-faint="#9f8aa0" c-hover="alpha(#ffffff, 0.1)"
        row flex=1 {
            column width=264 style=berinjela c-text="#ffffff" c-muted="#cdbdcd" c-faint="#9f8aa0" c-selected="#1164a3" c-hover="alpha(#ffffff, 0.08)" c-elevated="#5a2a5c" c-rail="#350d36" c-border="alpha(#ffffff, 0.12)" cd-selected="#1164a3" cd-elevated="#2a2830" cd-rail="#121016" {
                logo height=48 variant=wordmark size=16
                rule height=1 color=border
                guild-bar height=206 variant=list shape=squircle size=24 when=servidores
                rule height=1 color=border when=servidores
                channel-list flex=1 header=#false
                user-panel height=58 style=pe
            }
            column flex=1 bg=surface {
                header height=52 border-bottom="@border" c-rail="#ffffff" c-sidebar="#f1f1f3" cd-rail="#222529" cd-sidebar="#2a2d31"
                tabs height=36 variant=underline when=abas
                messages flex=1 avatar=square avatar-size=36 c-rail="#f4f4f6" cd-rail="#222529"
                column height=90 padding-x=18 {
                    spacer flex=1
                    composer height=46
                    spacer height=22
                }
            }
            member-list width=232 style=lateral hide-below=1150
        }
        status-bar height=26 variant=plain bg=elevated border-top="@border" when=status items="conn ping ram clock"
    }
}
