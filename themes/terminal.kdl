// terminal — tmux + IRC. Escuro: fósforo âmbar (ou verde). Claro: papel de
// impressora matricial. Exclusivo: efeito de monitor CRT, logo em ASCII,
// retícula de osciloscópio e um radar (ou mapa de curvas de nível) opcional.
theme "terminal" description="tmux + IRC: monoespaçado, canais em árvore, efeito CRT e logo em ASCII." description-en="tmux + IRC: monospace, channel tree, CRT effect and ASCII logo." author="SigmaCord" preview=terminal

options {
    option "crt" label="Efeito CRT" description="Linhas de varredura e cantos escuros, como um monitor antigo." label-en="CRT effect" description-en="Scanlines and dark corners, like an old monitor." default=#true
    option "ascii" label="Logo em ASCII" description="O nome do app desenhado com caracteres no topo dos canais." label-en="ASCII logo" description-en="The app name drawn in characters above the channels." default=#true
    option "verde" label="Fósforo verde" description="Troca o âmbar pelo verde dos terminais clássicos (modo escuro)." label-en="Green phosphor" description-en="Swaps amber for the green of classic terminals (dark mode)." default=#false
    option "reticula" label="Retícula" description="A grade fina de osciloscópio atrás do texto." label-en="Graticule" description-en="The fine oscilloscope grid behind the text." default=#true
    option "radar" label="Radar ao fundo" description="Um radar de fósforo, parado, atrás das janelas." label-en="Radar backdrop" description-en="A still phosphor radar behind the windows." default=#false
    option "mapa" label="Mapa topográfico" description="Curvas de nível atrás das janelas." label-en="Topographic map" description-en="Contour lines behind the windows." default=#false
    option "abas" label="Abas de canal" description="Mostra os canais abertos em abas no rodapé." label-en="Channel tabs" description-en="Shows open channels as tabs at the bottom." default=#true
}

colors mode=dark {
    bg         "#0b0906"
    rail       "#0b0906"
    sidebar    "#0b0906"
    surface    "#0b0906"
    elevated   "#18130b"
    overlay    "#120e08"
    text       "#ffcf73"
    muted      "#b58a45"
    faint      "#6f5730"
    accent     "#ffb000"
    accent-text "#0b0906"
    border     "#3d301b"
    hover      "alpha(#ffb000, 0.08)"
    selected   "alpha(#ffb000, 0.16)"
    online     "#a6e22e"
    idle       "#ffb000"
    dnd        "#ff5f5f"
    danger     "#ff5f5f"
    mention    "#ff6b35"
    link       "#5fd7d7"
    code-bg    "#1e170d"
    shadow     "alpha(black, 0.6)"
}
roles mode=dark "#ffd27a" "#ff8f5a" "#a6e22e" "#5fd7d7" "#d7a6ff" "#ffb000" "#ff6b9d" "#e8d5b0"

colors mode=dark when=verde {
    bg         "#050a06"
    rail       "#050a06"
    sidebar    "#050a06"
    surface    "#050a06"
    elevated   "#0c1a0f"
    overlay    "#081209"
    text       "#7dff9a"
    muted      "#3fbf62"
    faint      "#2a6b3a"
    accent     "#39ff6a"
    accent-text "#050a06"
    border     "#1d4a28"
    hover      "alpha(#39ff6a, 0.07)"
    selected   "alpha(#39ff6a, 0.15)"
    mention    "#d4ff5c"
    link       "#5fffd0"
    code-bg    "#0c1a0f"
}
roles mode=dark when=verde "#9dffb0" "#d4ff5c" "#5fffd0" "#7dff9a" "#b8ff8a" "#39ff6a" "#a0ffe0" "#cfffcf"

colors mode=light {
    bg         "#f4efe2"
    rail       "#f4efe2"
    sidebar    "#f4efe2"
    surface    "#f4efe2"
    elevated   "#e9e1cd"
    overlay    "#fbf8ef"
    text       "#2e2412"
    muted      "#6e5a35"
    faint      "#a3906a"
    accent     "#b35c00"
    accent-text "#fbf8ef"
    border     "#c9b98f"
    hover      "alpha(#b35c00, 0.07)"
    selected   "alpha(#b35c00, 0.14)"
    online     "#3d7a1f"
    idle       "#b35c00"
    dnd        "#b3261e"
    danger     "#b3261e"
    mention    "#b3261e"
    link       "#1f5f8b"
    code-bg    "#e9e1cd"
    shadow     "alpha(black, 0.12)"
}
roles mode=light "#7a4a00" "#9c3f10" "#3d6b1f" "#1f5f8b" "#6b3f8c" "#8a6a00" "#9c2f5a" "#4a4034"

fonts ui="JetBrains Mono" mono="JetBrains Mono" size=14
metrics radius=0

styles {
    style "box" border="@border" border-width=1 glow="@accent" inner-shadow="alpha(@accent, 0.05)" inner-shadow-size=10
}

layout {
    stack {
        spacer when=reticula pattern=grid pattern-size=24 pattern-color="alpha(@accent, 0.055)"
        topography when=mapa color="alpha(@accent, 0.20)"
        radar when=radar center-x=0.56 center-y=0.52 color="alpha(@accent, 0.30)" color2=accent
        column {
            guild-bar height=26 shape=text bg=elevated
            row flex=1 padding=6 gap=6 {
                column width=244 style=box {
                    logo height=70 variant=ascii size=11 when=ascii
                    channel-list flex=1 variant=tree inset-x=2
                    user-panel height=46 variant=tty
                }
                column flex=1 style=box {
                    header height=28 variant=tty
                    messages flex=1 variant=irc avatar=none
                    spacer height=22
                    composer height=34 variant=prompt
                }
                member-list width=192 style=box variant=tty hide-below=1100
            }
            tabs height=24 variant=tty bg=elevated when=abas
            status-bar height=24 variant=tty items="conn theme ping ram frame voice spacer keys clock"
        }
        crt when=crt
    }
}
