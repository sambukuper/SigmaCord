// vidro — cartões translúcidos flutuando sobre o wallpaper. O fundo da janela
// é transparente: o compositor (Hyprland, KDE…) aplica o blur de verdade.
// Exclusivo: reflexo de luz no topo de cada cartão, grão de vidro fosco e uma
// aurora opcional que passa por trás de tudo.
theme "vidro" description="Cartões de vidro sobre o wallpaper, com blur do compositor e reflexo." description-en="Glass cards over the wallpaper, with compositor blur and a sheen." author="SigmaCord" preview=glass
palette "wal"
window transparent=#true

options {
    option "brilho" label="Reflexo nos cartões" description="Uma faixa de luz no topo de cada cartão, como vidro de verdade." label-en="Card sheen" description-en="A strip of light at the top of each card, like real glass." default=#true
    option "aurora" label="Aurora ao fundo" description="Uma cortina de luz nas cores do tema atrás dos cartões. Parada: gerada uma vez." label-en="Aurora backdrop" description-en="A curtain of light in the theme colors behind the cards. Still: generated once." default=#true
    option "abas" label="Abas de canal" description="Mostra os canais abertos em abas acima da conversa." label-en="Channel tabs" description-en="Shows open channels as tabs above the conversation." default=#true
    option "banner" label="Banner do servidor" description="Faixa com o nome do servidor no topo dos canais." label-en="Server banner" description-en="A strip with the server name above the channels." default=#false
    option "opaco" label="Fundo opaco" description="Sem blur do compositor: os cartões ficam sólidos (mais leve)." label-en="Opaque background" description-en="No compositor blur: solid cards (lighter)." default=#false
    option "crt" label="Efeito CRT" description="Scanlines discretas por cima do vidro." label-en="CRT effect" description-en="Subtle scanlines over the glass." default=#false
}

colors mode=dark {
    bg        "alpha(mix(wal:0, black, 0.2), 0.30)"
    surface   "alpha(mix(wal:0, black, 0.15), 0.74)"
    rail      "alpha(mix(wal:0, black, 0.30), 0.80)"
    sidebar   "alpha(mix(wal:0, black, 0.15), 0.74)"
    elevated  "alpha(mix(wal:0, wal:15, 0.12), 0.90)"
    overlay   "alpha(mix(wal:0, black, 0.35), 0.96)"
    border    "alpha(wal:15, 0.10)"
    hover     "alpha(wal:15, 0.06)"
    selected  "alpha(wal:4, 0.22)"
    code-bg   "alpha(black, 0.32)"
    shadow    "alpha(black, 0.45)"
}

colors mode=light {
    bg        "alpha(white, 0.22)"
    surface   "alpha(white, 0.66)"
    rail      "alpha(white, 0.72)"
    sidebar   "alpha(white, 0.66)"
    elevated  "alpha(white, 0.86)"
    overlay   "alpha(white, 0.97)"
    border    "alpha(white, 0.65)"
    hover     "alpha(black, 0.05)"
    code-bg   "alpha(black, 0.06)"
    shadow    "alpha(black, 0.16)"
}

colors mode=dark when=opaco {
    bg        "mix(wal:0, black, 0.20)"
    surface   "mix(wal:0, black, 0.15)"
    rail      "mix(wal:0, black, 0.30)"
    sidebar   "mix(wal:0, black, 0.15)"
    elevated  "mix(wal:0, wal:15, 0.12)"
    overlay   "mix(wal:0, black, 0.35)"
    border    "alpha(wal:15, 0.18)"
    code-bg   "mix(wal:0, black, 0.32)"
}
colors mode=light when=opaco {
    bg        "mix(white, wal:0, 0.06)"
    surface   "mix(white, wal:0, 0.10)"
    rail      "mix(white, wal:0, 0.12)"
    sidebar   "mix(white, wal:0, 0.10)"
    elevated  "mix(white, wal:0, 0.16)"
    overlay   "mix(white, wal:0, 0.04)"
    border    "mix(wal:0, white, 0.55)"
    code-bg   "mix(white, wal:0, 0.18)"
}
roles mode=dark when=opaco "wal:4" "wal:1" "wal:3" "wal:2" "wal:5" "wal:6" "wal:7" "wal:15"
roles mode=light when=opaco "wal:4" "wal:1" "wal:3" "wal:2" "wal:5" "wal:6" "wal:7" "wal:0"

fonts ui="Inter" mono="JetBrains Mono" size=15
metrics radius=10

styles {
    // A borda pega a luz: forte num canto, quase some no meio do caminho.
    style "card" bg="@surface" radius=18 glow="alpha(@accent, 0.75)" border-width=1.5 drop-shadow="@shadow" drop-shadow-size=26 drop-shadow-y=8 sheen="$brilho" grain="alpha(@text, 0.035)" border-gradient="alpha(@text, 0.26) alpha(@text, 0.05) alpha(@text, 0.14)" border-gradient-angle=75
}
styles mode=light {
    style "card" bg="@surface" radius=18 glow="alpha(@accent, 0.75)" border-width=1.5 drop-shadow="@shadow" drop-shadow-size=26 drop-shadow-y=8 sheen="$brilho" grain="alpha(@text, 0.03)" border-gradient="alpha(white, 0.95) alpha(white, 0.35) alpha(white, 0.7)" border-gradient-angle=75
}

layout {
    stack {
        aurora when=aurora color="alpha(@accent, 0.55)" color2="alpha(wal:5, 0.42)"
        column padding=14 gap=10 {
            row flex=1 gap=10 {
                // Um único cartão para servidores + canais + painel do usuário.
                column width=300 style=card {
                    row flex=1 {
                        guild-bar width=58 inset-y=6 icon-style=soft shape=squircle size=40
                        channel-list flex=1 inset-y=4 banner="$banner"
                    }
                    user-panel height=58 inset-x=4
                }
                // A conversa inteira num cartão só, com as abas dentro dele.
                column flex=1 style=card {
                    header height=50 divider=#false
                    tabs height=44 variant=pills when=abas
                    messages flex=1 avatar=squircle inset-x=4
                    column height=92 padding-x=16 {
                        spacer flex=1
                        composer height=48 variant=pill
                        spacer height=16
                    }
                }
                member-list width=232 style=card hide-below=1180 inset-y=4
            }
            status-bar height=32 style=card variant=pills items="conn ping ram frame voice spacer theme keys clock"
        }
        crt when=crt spacing=4 strength=0.04
    }
}
