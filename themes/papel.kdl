// papel — um caderno: títulos em serifa, o índice na margem direita.
// Exclusivo: folha pautada com a margem vermelha, que rola junto com a conversa.
// Papel com grão, furos de fichário, a dobra da folha e o índice em página pontilhada.
theme "papel" description="Caderno: folha pautada com margem vermelha, títulos em serifa e índice." description-en="Notebook: ruled paper with a red margin, serif headings and an index." author="SigmaCord" preview=mirror

options {
    option "furos" label="Furos de fichário" description="Os três furos na beirada da folha." label-en="Binder holes" description-en="The three holes at the edge of the page." default=#true
    option "pautado" label="Folha pautada" description="Linhas de caderno atrás da conversa." label-en="Ruled paper" description-en="Notebook lines behind the conversation." default=#true
    option "margem" label="Margem vermelha" description="A linha dupla da margem, como num caderno escolar." label-en="Red margin" description-en="The double margin line, like a school notebook." default=#true
    option "indice" label="Índice" description="O título \"Índice\" no topo da margem direita." label-en="Index" description-en="The \"Index\" title at the top of the right margin." default=#true
    option "abas" label="Abas de canal" description="Mostra os canais abertos em abas acima da conversa." label-en="Channel tabs" description-en="Shows open channels as tabs above the conversation." default=#false
}

colors mode=light {
    bg          "#efe8da"
    rail        "#e4dac5"
    sidebar     "#ebe3d2"
    surface     "#f8f4ea"
    elevated    "#ebe3d2"
    overlay     "#fbf8f1"
    text        "#29231e"
    muted       "#6d6357"
    faint       "#a29785"
    accent      "#b23a2a"
    accent-text "#fbf8f1"
    border      "#dcd2bf"
    hover       "alpha(#29231e, 0.05)"
    selected    "alpha(#b23a2a, 0.11)"
    online      "#4d7a35"
    idle        "#b8860b"
    dnd         "#b23a2a"
    danger      "#b23a2a"
    mention     "#b23a2a"
    link        "#2f5d8c"
    code-bg     "#ece3cf"
    shadow      "alpha(#5a4320, 0.14)"
}
roles mode=light "#8c3b2a" "#2f5d8c" "#4d6b35" "#6d4b7d" "#94701f" "#2f6e6e" "#8a4060" "#5b4a3a"

// Escuro: o mesmo caderno à luz de um abajur.
colors mode=dark {
    bg          "#1a1612"
    rail        "#15120f"
    sidebar     "#1d1915"
    surface     "#211c17"
    elevated    "#2b251e"
    overlay     "#2a241d"
    text        "#ece3d2"
    muted       "#a99c86"
    faint       "#6f6455"
    accent      "#e0795d"
    accent-text "#1a1612"
    border      "#3a3229"
    hover       "alpha(#ece3d2, 0.05)"
    selected    "alpha(#e0795d, 0.14)"
    online      "#8fbf6a"
    mention     "#e0795d"
    link        "#86b3e0"
    code-bg     "#2b251e"
    shadow      "alpha(black, 0.4)"
}
roles mode=dark "#e8a083" "#86b3e0" "#a9c98a" "#c4a3d9" "#e0c070" "#7fc4c4" "#e090b0" "#c9b8a0"

fonts ui="Inter" mono="JetBrains Mono" size=16
metrics radius=4

styles mode=light {
    style "folha" gradient="lighten(@surface, 0.25) @surface" gradient-angle=0 grain="alpha(@text, 0.06)" vignette="alpha(@muted, 0.14)" vignette-size=0.5
    style "verso" gradient="mix(@sidebar, @muted, 0.20) @sidebar @sidebar" gradient-angle=0 grain="alpha(@text, 0.06)" pattern=dots pattern-size=18 pattern-width=1 pattern-color="alpha(@text, 0.14)"
}
styles mode=dark {
    style "folha" gradient="lighten(@surface, 0.02) @surface" gradient-angle=0 grain="alpha(@text, 0.025)" vignette="alpha(black, 0.35)" vignette-size=0.5
    style "verso" gradient="mix(@sidebar, black, 0.45) @sidebar @sidebar" gradient-angle=0 grain="alpha(@text, 0.025)" pattern=dots pattern-size=18 pattern-width=1 pattern-color="alpha(@text, 0.08)"
}

layout {
    row {
        column width=38 when=furos style=folha {
            spacer flex=1
            shape height=26 kind=ring size=16 thickness=1 color=border fill=rail
            spacer flex=3
            shape height=26 kind=ring size=16 thickness=1 color=border fill=rail
            spacer flex=3
            shape height=26 kind=ring size=16 thickness=1 color=border fill=rail
            spacer flex=1
        }
        column flex=1 style=folha {
            header height=86 variant=minimal inset-x=44 font="Liberation Serif"
            tabs height=36 variant=underline when=abas
            messages flex=1 avatar=none spacing=22 inset-x=28 ruled="$pautado" margin-line="$margem"
            column height=96 padding-x=44 {
                spacer flex=1
                composer height=46
                spacer height=24
            }
        }
        column width=272 style=verso {
            label height=62 text="Índice" text-en="Index" font="Liberation Serif" size=26 weight=italic color=text tracking=0.5 when=indice
            rule height=7 inset-x=10 kind=oxford color=text when=indice
            guild-bar height=206 variant=list shape=circle size=22 icon-style=soft
            rule height=9 inset-x=10 color=border ornament-text="§" ornament-size=13 ornament-color=accent font="Liberation Serif"
            channel-list flex=1 header=#false
            rule height=1 inset-x=10 kind=dotted color=muted
            user-panel height=56
        }
    }
}
