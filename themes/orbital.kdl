// orbital — console de bordo no meio do nada: campo de estrelas e um sistema de
// órbitas atrás de painéis translúcidos, tipografia técnica e uma faixa de
// servidores no rodapé. No claro vira carta celeste: tinta sobre papel.
theme "orbital" description="Console de bordo: grafite, menta, numeração de sistemas e servidores no rodapé." description-en="Ship console: graphite, mint, system numbering and servers in the bottom strip." author="SigmaCord" preview=glass

options {
    option "estrelas" label="Campo de estrelas" description="Estrelas paradas atrás dos painéis (geradas uma vez, não gastam nada)." label-en="Starfield" description-en="Still stars behind the panels (generated once, costs nothing)." default=#true
    option "orbitas" label="Sistema de órbitas" description="O diagrama de órbitas ao fundo." label-en="Orbit system" description-en="The orbit diagram in the background." default=#true
    option "movimento" label="Fundo em movimento" description="Estrelas e luas andam bem devagar, a 10 quadros por segundo. Desliga sozinho com \"Reduzir movimento\" e com a janela em segundo plano." label-en="Moving background" description-en="Stars and moons drift very slowly, at 10 frames per second. Turns itself off with \"Reduce motion\" and when the window is in the background." default=#false
    option "telemetria" label="Telemetria no topo" description="Conexão, ping, RAM e relógio na barra superior." label-en="Top telemetry" description-en="Connection, ping, RAM and clock in the top bar." default=#true
    option "abas" label="Abas de canal" description="Canais abertos em abas acima da conversa." label-en="Channel tabs" description-en="Open channels as tabs above the conversation." default=#true
    option "topo" label="Barra de busca" description="Mostra a barra de busca e ajuda abaixo do wordmark (Ctrl+K continua funcionando)." label-en="Search bar" description-en="Shows the search/help bar below the wordmark (Ctrl+K still works)." default=#false
    option "crt" label="Scanlines do console" description="Um leve efeito de tela de nave por cima de tudo." label-en="Console scanlines" description-en="A subtle ship-screen effect over everything." default=#false
}

colors mode=dark {
    bg          "#070c0b"
    rail        "#0a1110"
    sidebar     "#0c1513"
    surface     "#101917"
    elevated    "#182320"
    overlay     "#0c1513"
    text        "#e9e7df"
    muted       "#969b94"
    faint       "#58615c"
    accent      "#75e0be"
    accent-text "#04130e"
    border      "#26312e"
    hover       "alpha(#75e0be, 0.06)"
    selected    "alpha(#75e0be, 0.14)"
    online      "#75e0be"
    idle        "#e6c46a"
    dnd         "#ff7b8a"
    danger      "#ff7b8a"
    mention     "#ffb38a"
    link        "#93c5ff"
    code-bg     "#0b1311"
    bubble-self "alpha(#75e0be, 0.12)"
    bubble-self-text "#dff8ef"
    bubble-other "#141f1c"
    shadow      "alpha(black, 0.50)"
}
roles mode=dark "#75e0be" "#93c5ff" "#b8a6d9" "#e6c46a" "#ff9a9a" "#a9c98a" "#7fd6e8" "#e9e7df"

colors mode=light {
    bg          "#f2f1ea"
    rail        "#e7e5dc"
    sidebar     "#eeece4"
    surface     "#fbfaf5"
    elevated    "#ffffff"
    overlay     "#ffffff"
    text        "#141a17"
    muted       "#5e6a64"
    faint       "#98a39d"
    accent      "#0f7a66"
    accent-text "#ffffff"
    border      "#d3d5cc"
    hover       "alpha(#0f7a66, 0.06)"
    selected    "alpha(#0f7a66, 0.12)"
    online      "#0f7a66"
    idle        "#8a6a00"
    dnd         "#b3264a"
    danger      "#b3264a"
    mention     "#b3562e"
    link        "#1f5f8f"
    code-bg     "#e6e5dc"
    bubble-self "alpha(#0f7a66, 0.10)"
    bubble-self-text "#062a22"
    bubble-other "#eef0e8"
    shadow      "alpha(black, 0.10)"
}
roles mode=light "#0f7a66" "#1f5f8f" "#6b4f9e" "#8a6a00" "#a33a4a" "#3f7a4a" "#2f6e7a" "#3a4a50"

fonts ui="Inter Display" mono="Monaspace Argon" size=14
metrics radius=8

styles {
    // Painel de vidro fumê: o fundo passa um pouco, o texto não perde contraste.
    style "panel" radius=10 gradient="alpha(mix(@surface, @accent, 0.05), 0.90) alpha(@surface, 0.76)" border-gradient="alpha(@accent, 0.60) alpha(@border, 0.9) alpha(@border, 0.45)" border-gradient-angle=70 inner-shadow="alpha(@accent, 0.035)" inner-shadow-size=18 hover-bg="alpha(@accent, 0.012)" drop-shadow="@shadow" drop-shadow-size=20 drop-shadow-y=4
}

layout {
    stack gradient="mix(@bg, @accent, 0.08) @bg @rail" gradient-angle=120 {
        starfield when=estrelas color="alpha(@muted, 0.75)" color2="alpha(@accent, 0.8)" density=1.1 motion="$movimento"
        orbit when=orbitas center-x=0.73 center-y=0.40 rings=7 color="alpha(@accent, 0.42)" color2=accent motion="$movimento"
        column vignette="alpha(@shadow, 0.9)" vignette-size=0.5 {
            row height=46 gradient="alpha(@rail, 0.66) alpha(@rail, 0.30)" padding-x=16 gap=10 border-bottom="alpha(@accent, 0.38)" {
                stack width=28 {
                    shape kind=ring size=22 thickness=1 color="alpha(@accent, 0.35)"
                    shape kind=arc size=22 thickness=1.6 start=-150 sweep=250 color=accent dot="@text" dot-size=2.4
                    shape kind=circle size=6 color=accent
                }
                label width=210 text="ORBITAL" tracking=8 size=15 weight=bold font=mono text-gradient="@text @accent" text-gradient-angle=0 shadow="alpha(@accent, 0.30)" shadow-blur=2
                status-bar flex=1 variant=plain when=telemetria items="conn ping ram spacer clock"
                spacer flex=1 unless=telemetria
            }
            topbar height=32 gradient="alpha(@rail, 0.66) alpha(@rail, 0.30)" when=topo
            row flex=1 padding=14 gap=14 {
                column width=260 style=panel {
                    label height=38 size=9 color=muted font=mono span-gap=9 {
                        span "01" size=18 color=accent
                        span "CANAIS" en="CHANNELS" tracking=3
                    }
                    rule height=1 kind=dashed dash=3 gap=3 color="alpha(@accent, 0.45)"
                    channel-list flex=1 variant=discord inset-x=4 font=mono
                    rule height=1 inset-x=12 color=border
                    user-panel height=52 variant=tty inset-x=4
                }
                column flex=1 style=panel {
                    label height=38 size=9 color=muted font=mono span-gap=9 {
                        span "02" size=18 color=accent
                        span "CANAL" en="CHANNEL" tracking=3
                    }
                    rule height=1 kind=dashed dash=3 gap=3 color="alpha(@accent, 0.45)"
                    spacer height=6
                    header height=44 variant=minimal inset-x=18
                    tabs height=40 variant=underline when=abas font=mono
                    messages flex=1 variant=cozy avatar=square avatar-size=26 spacing=12
                    column height=84 padding-x=18 {
                        spacer flex=1
                        composer height=44 variant=prompt
                        spacer height=14
                    }
                }
                column width=220 style=panel hide-below=1120 {
                    label height=38 size=9 color=muted font=mono span-gap=9 {
                        span "03" size=18 color=accent
                        span "TRIPULAÇÃO" en="CREW" tracking=3
                    }
                    rule height=1 kind=dashed dash=3 gap=3 color="alpha(@accent, 0.45)"
                    member-list flex=1 variant=tty inset-y=4 font=mono
                }
            }
            row height=58 gradient="alpha(@rail, 0.30) alpha(@rail, 0.70)" padding-x=16 gap=14 border-top="alpha(@accent, 0.38)" {
                label width=142 size=9 color=muted font=mono span-gap=9 {
                    span "04" size=18 color=accent
                    span "SERVIDORES" en="SERVERS" tracking=2
                }
                guild-bar flex=1 orientation=horizontal variant=bar shape=squircle size=28 icon-style=outline labels=#false indicators=#false
                label width=86 text="DECK 07" tracking=2 size=9 color=muted align=right font=mono
            }
        }
        crt when=crt spacing=3 strength=0.04
    }
}
