// bolhas — mensageiro: servidores como pílulas no topo, canais grandes e a
// conversa em balões (os seus à direita). Exclusivo: "Entregue ✓✓" e o balão
// de "digitando" com os três pontinhos. Os cartões flutuam sobre um fundo
// pontilhado com uma luz colorida atrás.
theme "bolhas" description="Mensageiro: balões de conversa, \"Entregue ✓✓\" e balão de digitando." description-en="Messenger: chat bubbles, \"Delivered ✓✓\" and a typing bubble." author="SigmaCord" preview=bubbles

options {
    option "fundo" label="Fundo colorido" description="Pontinhos e uma luz suave atrás dos cartões." label-en="Colorful backdrop" description-en="Little dots and a soft glow behind the cards." default=#true
    option "entregue" label="Confirmação de entrega" description="Mostra \"Entregue ✓✓\" embaixo da sua última mensagem." label-en="Delivery receipt" description-en="Shows \"Delivered ✓✓\" under your last message." default=#true
    option "digitando" label="Balão de digitando" description="Os três pontinhos aparecem como um balão na conversa." label-en="Typing bubble" description-en="The three dots show up as a bubble in the chat." default=#true
    option "nomes" label="Nomes dos servidores" description="Mostra o nome ao lado do ícone na barra de cima." label-en="Server names" description-en="Shows the name next to the icon in the top bar." default=#true
    option "abas" label="Abas de canal" description="Mostra os canais abertos em abas dentro do cartão da conversa." label-en="Channel tabs" description-en="Shows open channels as tabs inside the chat card." default=#false
}

colors mode=light {
    bg          "#e9ebf5"
    rail        "#ffffff"
    sidebar     "#ffffff"
    surface     "#ffffff"
    elevated    "#f0f1f8"
    overlay     "#ffffff"
    text        "#1c1f33"
    muted       "#5b6080"
    faint       "#9a9fb8"
    accent      "#6c5ce7"
    accent-text "#ffffff"
    border      "#e1e3ee"
    hover       "alpha(#6c5ce7, 0.07)"
    selected    "alpha(#6c5ce7, 0.12)"
    online      "#22c55e"
    mention     "#6c5ce7"
    link        "#2563eb"
    code-bg     "#ecebf8"
    bubble-self "#6c5ce7"
    bubble-self-text "#ffffff"
    bubble-other "#eef0f7"
    shadow      "alpha(#2b2d6e, 0.13)"
}
roles mode=light "#6c5ce7" "#ef4444" "#d97706" "#059669" "#2563eb" "#db2777" "#7c3aed" "#0d9488"

colors mode=dark {
    bg          "#0c0e16"
    rail        "#161925"
    sidebar     "#161925"
    surface     "#161925"
    elevated    "#202433"
    overlay     "#1c2030"
    text        "#e8eaf6"
    muted       "#9aa0bd"
    faint       "#5f6585"
    accent      "#8b7cf6"
    accent-text "#0c0e16"
    border      "#262b3d"
    hover       "alpha(#8b7cf6, 0.08)"
    selected    "alpha(#8b7cf6, 0.16)"
    online      "#34d399"
    mention     "#a99cff"
    link        "#7aa7ff"
    code-bg     "#232838"
    bubble-self "#8b7cf6"
    bubble-self-text "#0c0e16"
    bubble-other "#232838"
    shadow      "alpha(black, 0.45)"
}
roles mode=dark "#a99cff" "#f87171" "#fbbf24" "#34d399" "#60a5fa" "#f472b6" "#c084fc" "#2dd4bf"

fonts ui="Inter" mono="JetBrains Mono" size=15
metrics radius=12

styles {
    style "sheet" radius=24 gradient="lighten(@surface, 0.02) @surface" border-gradient="alpha(@accent, 0.22) alpha(@border, 0.6) alpha(@accent, 0.08)" border-gradient-angle=70 drop-shadow="@shadow" drop-shadow-size=30 drop-shadow-y=10
    style "bar" radius=28 gradient="@surface mix(@surface, @accent, 0.04)" border-gradient="alpha(@accent, 0.22) alpha(@border, 0.6) alpha(@accent, 0.08)" border-gradient-angle=0 drop-shadow="@shadow" drop-shadow-size=20 drop-shadow-y=6
}

layout {
    stack gradient="@bg mix(@bg, @accent, 0.10) mix(@bg, @link, 0.08)" gradient-angle=125 {
    aurora when=fundo seed=31 color="alpha(@accent, 0.26)" color2="alpha(@mention, 0.18)"
    spacer when=fundo pattern=dots pattern-size=22 pattern-width=1.3 pattern-color="alpha(@accent, 0.16)"
    column padding=16 gap=14 {
        guild-bar height=56 orientation=horizontal labels="$nomes" size=34 style=bar icon-style=soft
        row flex=1 gap=14 {
            column width=272 style=sheet {
                channel-list flex=1 variant=pills inset-y=8 inset-x=4
                user-panel height=64 inset-x=8
            }
            column flex=1 style=sheet {
                header height=64 variant=minimal inset-x=22
                tabs height=44 variant=pills style=bar when=abas
                messages flex=1 variant=bubbles avatar=circle avatar-size=30 spacing=14 ticks="$entregue" typing-bubble="$digitando"
                column height=94 padding-x=20 {
                    spacer flex=1
                    composer height=52 variant=pill typing="$!digitando"
                    spacer height=20
                }
            }
            member-list width=236 style=sheet hide-below=1150
        }
    }
    }
}
